        "responsibility": "Provide typed ACL, RBAC, and ABAC policy evaluation, immutable revisioned snapshots, bounded policy compilation, fail-closed transport integration, and explicit persistence and invalidation adapters.",
        "non_goals": [
          "Authenticate principals, establish tenant membership, own application resources, or infer authoritative request attributes.",
          "Own database, cache, transport, logging, telemetry, or application lifecycle resources.",
          "Provide a positional string policy language, hidden global policy registry, or permissive fallback behavior."
        ],
        "public_package_identifier": "authorization",
        "primary_entry_packages": [
          "github.com/faustbrian/go-authorization"
        ],
        "package_selection": {
          "github.com/faustbrian/go-authorization": "Use for typed authorization requests and decisions, immutable snapshots, policy composition, and fail-closed evaluation.",
          "github.com/faustbrian/go-authorization/abac": "Use for bounded attribute-based policies with typed conditions and deterministic evaluation limits.",
          "github.com/faustbrian/go-authorization/acl": "Use for typed subject-to-resource access control lists and bounded resource listing.",
          "github.com/faustbrian/go-authorization/authcache": "Use for advisory cache integration keyed by exact policy revision while retaining the repository as source of truth.",
          "github.com/faustbrian/go-authorization/authhttp": "Use for the canonical fail-closed net/http authorization adapter.",
          "github.com/faustbrian/go-authorization/authlog": "Use to emit bounded authorization audit events through log/slog.",
          "github.com/faustbrian/go-authorization/authn": "Use to map an already authenticated principal into a typed authorization subject without validating credentials.",
          "github.com/faustbrian/go-authorization/authorizationtest": "Use in tests for deterministic requests, evaluators, assertions, snapshots, and adapter conformance.",
          "github.com/faustbrian/go-authorization/authotel": "Use to observe authorization decisions through caller-owned OpenTelemetry providers.",
          "github.com/faustbrian/go-authorization/authrpc": "Use for fail-closed native go-jsonrpc authorization middleware.",
          "github.com/faustbrian/go-authorization/httpauth": "Use only as the released compatibility path for the canonical authhttp adapter.",
          "github.com/faustbrian/go-authorization/policy": "Use for strict portable manifests, compilation, diff, dry-run, synchronization, and revisioned activation.",
          "github.com/faustbrian/go-authorization/postgres": "Use for caller-owned PostgreSQL persistence of complete policy manifests with optimistic revision checks.",
          "github.com/faustbrian/go-authorization/rbac": "Use for tenant-safe roles, permissions, assignments, and bounded inheritance.",
          "github.com/faustbrian/go-authorization/valkey": "Use for caller-owned Valkey revision invalidation with durable polling fallback."
        },
